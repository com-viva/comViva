# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# O arquivo .env NAO e versionado (ver .gitignore na raiz do repositorio).

# Chave de assinatura dos tokens JWT (HS256 / HMAC-SHA256).
# Precisa ter no minimo 256 bits (32 bytes) decodificados em Base64.
# Gere uma nova com: openssl rand -base64 32
JWT_SECRET=

# Credenciais do banco de dados
DB_USERNAME=postgres
DB_PASSWORD=

# Tempo de validade do token JWT em milissegundos (padrao: 3600000 = 1 hora)
JWT_EXPIRATION_MS=3600000

# Emissor do token JWT
JWT_ISSUER=comviva
